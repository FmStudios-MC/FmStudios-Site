---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import Arrow from "../../components/Arrow.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("news")).filter((p) => !p.data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const fmtDate = (d: Date) =>
  new Intl.DateTimeFormat("en-GB", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  }).format(d);

const fmtISO = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout title={data.title} description={data.summary}>
  <article class="post">
    <div class="container">
      <a href="/news" class="back-link">
        <Arrow dir="left" /> All news
      </a>
    </div>

    <header class="post__hero container">
      <h1 class="post__title">{data.title}</h1>
      <p class="post__summary">{data.summary}</p>
      <div class="post__dateline">
        <time datetime={fmtISO(data.date)}>{fmtDate(data.date)}</time>
        <span class="post__sep" aria-hidden="true">/</span>
        <span class="post__author">{data.author}</span>
      </div>
      {
        data.tags.length > 0 && (
          <ul class="taglist" role="list" aria-label="Tags">
            {data.tags.map((t) => (
              <li class="tag">{t}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      data.image && (
        <div class="container">
          <Image
            src={data.image}
            alt={`${data.title} cover image`}
            width={1280}
            height={720}
            class="post__cover"
          />
        </div>
      )
    }

    <div class="container post__body">
      <div class="prose">
        <Content />
      </div>
    </div>

    <div class="container post__foot">
      <Button href="/news" variant="ghost">Back to all news</Button>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    position: relative;
    z-index: var(--z-base);
    padding-top: var(--space-m);
  }

  .post__hero {
    padding-block: var(--space-xl) var(--space-l);
  }

  .post__dateline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
    margin-top: var(--space-m);
  }

  .post__author {
    font-family: var(--font-body);
    font-size: var(--step-0);
    color: var(--text-muted);
  }

  .post__dateline time {
    color: var(--text-muted);
  }

  .post__sep {
    color: var(--line-strong);
  }

  .post__title {
    font-size: var(--step-5);
    line-height: 0.98;
    max-width: 18ch;
  }

  .post__summary {
    margin-top: var(--space-m);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 1.2;
    color: var(--text);
    max-width: 40ch;
  }

  .taglist {
    margin-top: var(--space-l);
  }

  .post__cover {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-top: var(--space-l);
  }

  .post__body {
    padding-block: var(--space-xl) var(--space-l);
    border-top: 1px solid var(--line);
  }

  .post__foot {
    padding-bottom: var(--space-2xl);
  }

  @media (max-width: 720px) {
    .post__hero {
      padding-block: var(--space-l) var(--space-m);
    }
  }
</style>
