---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = (await getCollection("projects")).sort((a, b) => {
  // Released first, then by order
  const statusRank = (s: string) => (s === "Released" ? 0 : 1);
  const byStatus = statusRank(a.data.status) - statusRank(b.data.status);
  return byStatus !== 0 ? byStatus : a.data.order - b.data.order;
});

const order = ["Modpacks", "Mods", "Resource Packs", "Roblox", "Programs"];
const present = order.filter((t) => projects.some((p) => p.data.type === t));
const filters = ["All", ...present];
---

<BaseLayout
  title="Work"
  description="Projects from FabiMvurice Interactive: Minecraft modpacks, mods, resource packs, Roblox games, and programs."
>
  <PageHeader
    eyebrow="The work"
    title="Everything the studio ships."
    lede="Modpacks, mods, resource packs, Roblox games, and standalone programs. Filter by what you are looking for."
  />

  <section class="section work" aria-labelledby="work-heading">
    <div class="container-wide">
      <h2 id="work-heading" class="visually-hidden">All projects</h2>

      <div class="filters" role="group" aria-label="Filter projects by type">
        {
          filters.map((f, i) => (
            <button
              type="button"
              class="filter"
              aria-pressed={i === 0 ? "true" : "false"}
              data-filter={f}
            >
              {f}
            </button>
          ))
        }
      </div>

      <p class="visually-hidden" role="status" data-filter-status></p>

      <div class="work-grid" data-grid>
        {
          projects.map((project, i) => (
            <div class="work-grid__cell" data-type={project.data.type}>
              <ProjectCard project={project} delay={(i % 3) * 0.07} />
            </div>
          ))
        }
      </div>

      <p class="work-empty" data-empty hidden>
        Nothing here yet. More is in the workshop.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import { initListFilter } from "../../scripts/filter";

  initListFilter({
    itemAttr: "data-type",
    announce: (shown, filter) =>
      filter === "All"
        ? `Showing all ${shown} projects.`
        : `Showing ${shown} ${shown === 1 ? "project" : "projects"} in ${filter}.`,
  });
</script>

<style>
  .work {
    padding-top: 0;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-l);
  }

  .work-grid__cell[hidden] {
    display: none;
  }

  .work-empty {
    color: var(--ink-muted);
    padding-block: var(--space-2xl);
    text-align: center;
    font-size: var(--step-1);
  }
</style>
