---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import Arrow from "../../components/Arrow.astro";
import ArtPlaceholder from "../../components/ArtPlaceholder.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const isLive = data.status === "Released";

const meta = [
  { label: "Type", value: data.type },
  { label: "Status", value: data.status },
  data.version ? { label: "Minecraft", value: data.version } : null,
  data.loader ? { label: "Loader", value: data.loader } : null,
].filter(Boolean) as { label: string; value: string }[];
---

<BaseLayout title={data.title} description={data.summary}>
  <article class="detail">
    <header class="detail__hero lattice">
      <div class="container">
        <a href="/work" class="back-link">
          <Arrow dir="left" /> All work
        </a>
      </div>

      <div class="container detail__hero-inner">
        <div class="detail__intro">
          <h1 class="detail__title">{data.title}</h1>
          <p class="detail__tagline">{data.tagline}</p>
          <div class="detail__tags">
            <span class:list={["plate", { "plate--lit": isLive }]}>{data.status}</span>
            <span class="data">{data.type}</span>
          </div>

          {
            data.links.length > 0 ? (
              <div class="detail__actions">
                {data.links.map((link, i) => (
                  <Button
                    href={link.url}
                    external
                    variant={i === 0 ? "primary" : "ghost"}
                  >
                    {link.label}
                  </Button>
                ))}
              </div>
            ) : (
              <p class="detail__nolinks">
                {isLive
                  ? "Download links are being added. Check back shortly."
                  : "This project isn't released yet and can't be downloaded. Links will appear here on launch."}
              </p>
            )
          }
        </div>

        <div class="detail__art block">
          {
            data.image ? (
              <Image
                src={data.image}
                alt={`${data.title} project art`}
                width={720}
                height={720}
                class="detail__img"
                loading="eager"
              />
            ) : (
              <ArtPlaceholder title={data.title} />
            )
          }
        </div>
      </div>
    </header>

    <div class="container detail__body">
      <dl class="detail__meta">
        {
          meta.map((m) => (
            <div class="detail__meta-row">
              <dt>{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="prose detail__prose">
        <p class="detail__summary">{data.summary}</p>
        <Content />
      </div>
    </div>

    <div class="container detail__foot">
      <Button href="/work" variant="ghost">Back to all work</Button>
    </div>
  </article>
</BaseLayout>

<style>
  .detail {
    position: relative;
    z-index: var(--z-base);
  }

  .detail__hero {
    padding-block: var(--space-m) var(--space-2xl);
    border-bottom: 1px solid var(--line);
  }

  .detail__hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: var(--space-2xl);
    padding-top: var(--space-xl);
  }

  .detail__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
    margin-top: var(--space-m);
  }

  .detail__title {
    font-size: var(--step-5);
    line-height: 0.98;
  }

  .detail__tagline {
    margin-top: var(--space-m);
    font-size: var(--step-1);
    color: var(--text-muted);
    max-width: 40ch;
  }

  .detail__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
    margin-top: var(--space-l);
  }

  .detail__nolinks {
    margin-top: var(--space-l);
    color: var(--text-muted);
    padding: var(--space-s) var(--space-m);
    border: 1px dashed var(--line-strong);
    max-width: 52ch;
  }

  /* The project's art on the front face of a large block */
  .detail__art {
    --depth: 44px;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    padding: var(--space-l);
    background: var(--well);
  }

  .detail__img {
    width: min(94%, 520px);
    height: auto;
    object-fit: contain;
  }

  .detail__body {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: var(--space-2xl);
    padding-block: var(--space-xl) var(--space-l);
  }

  /* Spec plate: the facts a player checks before downloading */
  .detail__meta {
    align-self: start;
    position: sticky;
    top: 7rem;
    border: 1px solid var(--line-strong);
    border-top: 3px solid var(--brass);
  }

  .detail__meta-row {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    padding: var(--space-xs) var(--space-s);
  }

  .detail__meta-row + .detail__meta-row {
    border-top: 1px solid var(--line);
  }

  .detail__meta dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .detail__meta dd {
    font-weight: 500;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .detail__summary {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 1.2;
    color: var(--text);
    margin-bottom: var(--space-l);
  }

  .detail__foot {
    padding-bottom: var(--space-2xl);
  }

  @media (max-width: 860px) {
    .detail__hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
    .detail__art {
      --depth: 26px;
      order: -1;
      max-width: 320px;
      padding: var(--space-l);
    }
    .detail__body {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
    .detail__meta {
      position: static;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    }
    .detail__meta-row + .detail__meta-row {
      border-top: none;
    }
  }
</style>
