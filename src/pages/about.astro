---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Button from "../components/Button.astro";
import Symbol from "../assets/brand/neolqua-symbol-white.svg";

const disciplines = [
  {
    name: "Minecraft Modpacks",
    body: "Curated, balanced packs with a real progression arc, built around Create and beyond.",
  },
  {
    name: "Mods",
    body: "Focused mods that fix one thing properly, from per-player loot to new content.",
  },
  {
    name: "Resource Packs",
    body: "Textures and assets that change how a world feels, not just how it looks.",
  },
  {
    name: "Roblox Games",
    body: "Playable experiences built for the Roblox platform and its community.",
  },
  {
    name: "Programs",
    body: "Standalone tools and programs, the studio's next frontier.",
  },
];

const principles = [
  {
    t: "Craft over volume",
    d: "We would rather ship one pack that feels considered than ten that feel automated.",
  },
  {
    t: "Play it ourselves",
    d: "If a release is not fun to play through, it does not ship. We are the first testers.",
  },
  {
    t: "Built to last",
    d: "Clean configs, sensible defaults, and updates that respect the people running servers.",
  },
];
---

<BaseLayout
  title="About"
  description="Neolqua Studios is a studio crafting Minecraft modpacks, mods, resource packs, Roblox games, and programs with deliberate care."
>
  <PageHeader
    title="A small studio with a high bar."
    lede="Neolqua Studios makes things for the games people already love, and treats each release like it deserves a stage."
  />

  <section class="section intro">
    <div class="container intro__grid">
      <div class="intro__copy">
        <p class="intro__lead">
          We started where a lot of creators do: deep inside Minecraft, taking
          apart what worked and rebuilding it better. That instinct never left.
        </p>
        <p>
          Today the studio spans modpacks, mods, and resource packs, with
          standalone programs on the way. The thread through all of it is the
          same: deliberate work, made by people who actually play what they
          build.
        </p>
        <p>
          Neolqua stays small on purpose. It means every decision is intentional,
          every release carries the studio's name with confidence, and nothing
          ships just to fill a calendar.
        </p>
      </div>
      <div class="intro__mark water" aria-hidden="true">
        <Symbol class="intro__symbol" />
      </div>
    </div>
  </section>

  <section class="section disciplines">
    <div class="container">
      <h2 class="disciplines__title reveal">What we build</h2>
      <ul class="disciplines__list" role="list">
        {
          disciplines.map((d, i) => (
            <li class="discipline reveal" style={`--reveal-delay:${i * 0.05}s`}>
              <span class="discipline__name">{d.name}</span>
              <p class="discipline__body">{d.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section principles">
    <div class="container">
      <h2 class="principles__title reveal">How we work</h2>
      <ul class="principles__grid" role="list">
        {
          principles.map((p, i) => (
            <li class="principle reveal" style={`--reveal-delay:${i * 0.07}s`}>
              <h3 class="principle__t">{p.t}</h3>
              <p class="principle__d">{p.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section about-cta">
    <div class="container">
      <div class="about-cta__inner water reveal">
      <h2>See what that looks like in practice.</h2>
      <div class="about-cta__actions">
        <Button href="/work">Browse the work</Button>
        <Button href="/contact" variant="ghost">Work with us</Button>
      </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-top: 0;
  }

  .intro__grid {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    align-items: center;
    gap: var(--space-2xl);
  }

  .intro__lead {
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: var(--step-2);
    line-height: 1.2;
    color: var(--text);
    /* Held to a display measure; the paragraphs under it cap at 60ch and the
       opener ran wider than both. */
    max-width: 30ch;
    margin-bottom: var(--space-m);
    text-wrap: balance;
  }

  .intro__copy p + p {
    margin-top: var(--space-m);
    color: var(--text-muted);
    max-width: 60ch;
    line-height: 1.7;
  }

  /* The drop in its own small pool. */
  .intro__mark {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    padding: var(--space-l);
    border-radius: var(--drop);
  }

  .intro__mark :global(.intro__symbol) {
    width: min(70%, 13rem);
  }

  .disciplines__title,
  .principles__title {
    font-size: var(--step-3);
    margin-bottom: var(--space-l);
  }

  .disciplines__list {
    list-style: none;
    padding: 0;
    border-top: 8px solid var(--abyss);
  }

  .discipline {
    display: grid;
    grid-template-columns: 0.4fr 0.6fr;
    gap: var(--space-l);
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--line);
    align-items: baseline;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .discipline:hover {
    background: var(--coping);
  }

  .discipline__name {
    font-weight: 700;
    font-size: var(--step-1);
    padding-left: var(--space-xs);
  }

  .discipline__body {
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 52ch;
  }

  /* Columns under a rule rather than boxes: the same hairline language as the
     disciplines list and the roadmap lanes, without a third card treatment
     and without numbering three items that carry no order. */
  .principles__grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-l) var(--space-xl);
  }

  .principle {
    padding-top: var(--space-s);
    border-top: 8px solid var(--abyss);
  }

  .principle__t {
    font-size: var(--step-1);
    margin-bottom: var(--space-2xs);
  }

  .principle__d {
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 34ch;
  }

  .about-cta__inner {
    border-radius: var(--drop);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-l);
    padding: clamp(2rem, 5vw, 4rem);
  }

  .about-cta__inner h2 {
    font-size: var(--step-4);
    max-width: 18ch;
  }

  .about-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
  }

  @media (max-width: 860px) {
    .intro__grid {
      grid-template-columns: 1fr;
    }
    .intro__mark {
      order: -1;
      width: min(100%, 14rem);
    }
  }

  @media (max-width: 560px) {
    .discipline {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
    }
  }
</style>
