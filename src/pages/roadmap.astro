---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Button from "../components/Button.astro";

type Status = "planned" | "in-progress" | "released";

interface Item {
  title: string;
  kind: string;
  when: string;
  summary: string;
}

// Milestones. Edit these to reshape the board. Lanes render past to future
// (released, in progress, planned) along one line, whatever order they sit in here.
const board: { status: Status; label: string; items: Item[] }[] = [
  {
    status: "planned",
    label: "Planned",
    items: [
      {
        title: "Programs: standalone toolset",
        kind: "Programs",
        when: "Later",
        summary:
          "The studio's first desktop utilities, built outside the game sandbox.",
      },
    ],
  },
  {
    status: "in-progress",
    label: "In progress",
    items: [
        {
        title: "{Additions} Rebound",
        kind: "Modpack",
        when: "TBD",
        summary:
          "A new Vanilla+ pack with focus on QOL and performance.",
      },
    ],
  },
  {
    status: "released",
    label: "Released",
    items: [
      {
        title: "Neolqua site rework",
        kind: "Studio",
        when: "Shipped",
        summary: "Our main page for news, info, and sharing the work as it happens.",
      },
      {
        title: "Create Unbound",
        kind: "Modpack",
        when: "Released",
        summary:
          "A Create Modpack with many great addons and QOL mods.",
      },
    ],
  },
];

const timeline: Status[] = ["released", "in-progress", "planned"];
const lanes = timeline.map((s) => board.find((l) => l.status === s)!);
---

<BaseLayout
  title="Roadmap"
  description="What Neolqua Studios is planning, building, and has already shipped, on one board."
>
  <PageHeader
    title="Where the studio is headed."
    lede="A working board of what is planned, in progress, and already out the door. Honest, not a promise, and it moves as the work does."
  />

  <section class="section roadmap">
    <div class="container-wide">
      <ol class="pool water list-reset" role="list">
        {
          lanes.map((lane, laneIndex) => (
            <li
              class:list={["lane reveal", `lane--${lane.status}`]}
              style={`--reveal-delay:${laneIndex * 0.08}s`}
              aria-labelledby={`lane-${lane.status}`}
            >
              {laneIndex > 0 && <div class="lane-line" aria-hidden="true" />}
              <div class="lane__row">
                <header class="lane__head">
                  <h2 class="lane__label" id={`lane-${lane.status}`}>
                    {lane.label}
                  </h2>
                  <span class="lane__count">
                    {lane.items.length}
                    {lane.items.length === 1 ? " item" : " items"}
                  </span>
                  {lane.status === "in-progress" && <span class="now">Now</span>}
                </header>

                <ol class="lane__list list-reset" role="list">
                  {lane.items.map((item) => (
                    <li class="ritem">
                      <h3 class="ritem__title">{item.title}</h3>
                      <p class="ritem__summary">{item.summary}</p>
                      <div class="ritem__meta">
                        <span class="ritem__kind">{item.kind}</span>
                        <span class="ritem__when">{item.when}</span>
                      </div>
                    </li>
                  ))}
                </ol>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="roadmap__foot reveal">
        <p class="roadmap__note">
          Dates stay loose on purpose. The studio ships when a release is worth
          playing, not to fill a calendar.
        </p>
        <div class="roadmap__actions">
          <Button href="/news">Follow the updates</Button>
          <Button href="/work" variant="ghost">See the work</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .roadmap {
    padding-top: 0;
  }

  /* The board is a pool: one lane per stage, past to future, split by painted
     lane lines. Each lane says how many items it holds. */
  .pool {
    border-radius: var(--drop);
    padding: clamp(1.5rem, 4vw, 3.5rem);
  }

  .lane-line {
    margin-block: var(--space-l);
  }

  .lane__row {
    display: grid;
    grid-template-columns: minmax(10rem, 0.3fr) minmax(0, 1fr);
    gap: var(--space-m) var(--space-l);
    align-items: start;
  }

  .lane__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-xs);
  }

  .lane__label {
    flex-basis: 100%;
    font-size: var(--step-3);
  }

  .lane__count {
    font-weight: 500;
  }

  /* The one marker on the board: where the studio is today. */
  .now {
    padding: 0.3em 0.85em;
    border-radius: var(--drop-pill);
    background: var(--abyss);
    color: var(--neo-aqua);
    font-weight: 600;
    font-size: var(--step--1);
  }

  .lane__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-s);
  }

  /* Items float in their lane as coping tiles. */
  /* One tile footprint for every item, whatever its copy. */
  .ritem {
    display: flex;
    flex-direction: column;
    min-height: 14.5rem;
    padding: var(--space-m);
    background: var(--coping);
    border-radius: var(--drop-s);
    color: var(--text);
  }

  .lane--planned .ritem {
    background: rgb(255 255 255 / 0.72);
  }

  .ritem__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: auto;
    padding-top: var(--space-s);
    font-size: var(--step--1);
  }

  .ritem__kind {
    font-weight: 600;
    color: var(--link);
  }

  .ritem__when {
    font-weight: 500;
    color: var(--text-faint);
  }

  .ritem__title {
    font-size: var(--step-1);
    line-height: 1.15;
  }

  .ritem__summary {
    margin-top: var(--space-2xs);
    color: var(--text-muted);
    max-width: 42ch;
  }

  .roadmap__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    margin-top: var(--space-xl);
  }

  .roadmap__note {
    color: var(--text-muted);
    max-width: 46ch;
  }

  .roadmap__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  @media (max-width: 760px) {
    .lane__row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
