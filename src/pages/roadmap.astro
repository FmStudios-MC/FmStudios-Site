---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Button from "../components/Button.astro";

type Status = "planned" | "in-progress" | "released";

interface Item {
  title: string;
  kind: string;
  when: string;
  summary: string;
}

// Milestones. Edit these to reshape the board. Lanes render past to future
// (released, in progress, planned) along one line, whatever order they sit in here.
const board: { status: Status; label: string; items: Item[] }[] = [
  {
    status: "planned",
    label: "Planned",
    items: [
      {
        title: "Programs: standalone toolset",
        kind: "Programs",
        when: "Later",
        summary:
          "The studio's first desktop utilities, built outside the game sandbox.",
      },
    ],
  },
  {
    status: "in-progress",
    label: "In progress",
    items: [
        {
        title: "{Additions} Rebound",
        kind: "Modpack",
        when: "TBD",
        summary:
          "A new Vanilla+ pack with focus on QOL and performance.",
      },
    ],
  },
  {
    status: "released",
    label: "Released",
    items: [
      {
        title: "FMI site rework",
        kind: "Studio",
        when: "Shipped",
        summary: "Our main page for news, info, and sharing the work as it happens.",
      },
      {
        title: "Create Unbound",
        kind: "Modpack",
        when: "Released",
        summary:
          "A Create Modpack with many great addons and QOL mods.",
      },
    ],
  },
];

const timeline: Status[] = ["released", "in-progress", "planned"];
const lanes = timeline.map((s) => board.find((l) => l.status === s)!);
---

<BaseLayout
  title="Roadmap"
  description="What FabiMvurice Interactive is planning, building, and has already shipped, on one board."
>
  <PageHeader
    title="Where the studio is headed."
    lede="A working board of what is planned, in progress, and already out the door. Honest, not a promise, and it moves as the work does."
  />

  <section class="section roadmap">
    <div class="container-wide">
      <ol class="track list-reset" role="list">
        {
          lanes.map((lane, laneIndex) => (
            <li
              class:list={["lane reveal", `lane--${lane.status}`]}
              style={`--reveal-delay:${laneIndex * 0.08}s`}
              aria-labelledby={`lane-${lane.status}`}
            >
              <header class="lane__head">
                {lane.status === "in-progress" && (
                  <span class="now">
                    <span class="now__mark" aria-hidden="true" />
                    Now
                  </span>
                )}
                <h2 class="lane__label" id={`lane-${lane.status}`}>
                  {lane.label}
                </h2>
                <span class="lane__count data">
                  {lane.items.length}
                  <span class="visually-hidden">
                    {lane.items.length === 1 ? " item" : " items"}
                  </span>
                </span>
              </header>

              <ol class="lane__list list-reset" role="list">
                {lane.items.map((item) => (
                  <li class="ritem">
                    <h3 class="ritem__title">{item.title}</h3>
                    <p class="ritem__summary">{item.summary}</p>
                    <div class="ritem__meta">
                      <span class="ritem__kind">{item.kind}</span>
                      <span class="data">{item.when}</span>
                    </div>
                  </li>
                ))}
              </ol>
            </li>
          ))
        }
      </ol>

      <div class="roadmap__foot reveal">
        <p class="roadmap__note">
          Dates stay loose on purpose. The studio ships when a release is worth
          playing, not to fill a calendar.
        </p>
        <div class="roadmap__actions">
          <Button href="/news">Follow the updates</Button>
          <Button href="/work" variant="ghost">See the work</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .roadmap {
    padding-top: 0;
  }

  /* One unbroken line runs under every lane head, past to future. The
     released stretch is lit brass; the line ahead is plain. */
  .track {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .lane {
    --rail: var(--line-strong);
    padding-right: var(--space-l);
  }

  .lane--released {
    --rail: var(--brass);
  }

  .lane__head {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding-top: var(--space-l);
    padding-bottom: var(--space-s);
    margin-right: calc(var(--space-l) * -1);
    border-top: 3px solid var(--rail);
  }

  .lane__label {
    font-size: var(--step-1);
    letter-spacing: 0.04em;
  }

  .lane--planned .lane__label {
    color: var(--text-muted);
  }

  .lane__count {
    margin-right: var(--space-l);
    margin-left: auto;
  }

  /* The one marker on the line: where the studio is today */
  .now {
    position: absolute;
    left: 0;
    top: -0.85rem;
    translate: -50% -100%;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brass-lit);
  }

  .now__mark {
    order: 2;
    width: 0.9rem;
    height: 0.9rem;
    background: var(--brass);
    rotate: 45deg;
    translate: 0 0.95rem;
  }

  .ritem {
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--line);
  }

  .ritem__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: var(--space-xs);
  }

  .ritem__kind {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .ritem__title {
    font-size: var(--step-1);
    line-height: 1.15;
  }

  .ritem__summary {
    margin-top: var(--space-2xs);
    color: var(--text-muted);
    max-width: 42ch;
  }

  .roadmap__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
  }

  .roadmap__note {
    color: var(--text-muted);
    max-width: 46ch;
  }

  .roadmap__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
  }

  /* Phones: the line turns and runs down the left edge */
  @media (max-width: 820px) {
    .track {
      grid-template-columns: 1fr;
      padding-left: var(--space-m);
    }
    .lane {
      padding-right: 0;
      padding-left: var(--space-m);
      border-left: 3px solid var(--rail);
      padding-bottom: var(--space-l);
    }
    .lane__head {
      margin-right: 0;
      border-top: none;
      padding-top: 0;
    }
    .lane__count {
      margin-right: 0;
    }
    .now {
      position: static;
      translate: none;
      flex-direction: row;
      order: -1;
    }
    .now__mark {
      order: 0;
      translate: none;
      position: absolute;
      left: calc(var(--space-m) * -1 - 1.5px - 0.45rem);
      top: 0.4rem;
    }
  }
</style>
