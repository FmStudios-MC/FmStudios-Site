---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandSymbol from "../components/BrandSymbol.astro";
import Button from "../components/Button.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Arrow from "../components/Arrow.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

// What is on the bench right now: the released ports for the newest
// Minecraft version. Driven by content, so it moves when the versions do.
const benchVersion = "26.2";
const bench = projects.filter(
  (p) =>
    p.data.status === "Released" &&
    p.data.version?.split(",")[0].trim() === benchVersion,
);
const featured = projects
  .filter((p) => p.data.featured && !bench.includes(p))
  .slice(0, 3);

const disciplineCount = 5;
const releasedCount = projects.filter(
  (p) => p.data.status === "Released",
).length;
---

<BaseLayout>
  <section class="hero lattice">
    <div class="hero__inner container-wide">
      <div class="hero__copy">
        <h1 class="hero__title">
          We build worlds inside the games you already love.
        </h1>

        <p class="hero__lede lede">
          FabiMvurice Interactive is a studio crafting Minecraft modpacks, mods,
          and resource packs, Roblox games, and standalone programs. Built with
          deliberate care, made to be played.
        </p>

        <div class="hero__actions">
          <Button href="/work">Explore the work</Button>
          <Button href="/contact" variant="ghost">Start a conversation</Button>
        </div>
      </div>

      <div class="hero__mark">
        <BrandSymbol class="hero__symbol" assemble decorative />
      </div>
    </div>

    {
      bench.length > 0 && (
        <div class="bench container-wide" aria-labelledby="bench-title">
          <div class="bench__head">
            <h2 class="bench__title" id="bench-title">On the bench</h2>
            <p class="bench__sub">Create Fly ports for Minecraft {benchVersion}</p>
          </div>

          <ul class="bench__list list-reset" role="list">
            {bench.map((p) => (
              <li class="bench__item block">
                <div class="bench__art">
                  {p.data.image && (
                    <Image
                      src={p.data.image}
                      alt=""
                      width={160}
                      height={160}
                      loading="eager"
                    />
                  )}
                </div>
                <div class="bench__body">
                  <h3 class="bench__name">
                    <a href={`/work/${p.id}`}>{p.data.title}</a>
                  </h3>
                  <p class="data">
                    {p.data.loader} / MC {p.data.version}
                  </p>
                  <div class="bench__links">
                    {p.data.links.map((link, i) => (
                      <Button
                        href={link.url}
                        external
                        size="small"
                        variant={i === 0 ? "primary" : "ghost"}
                      >
                        {link.label}
                      </Button>
                    ))}
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <section class="section work-preview" aria-labelledby="work-title">
    <div class="container-wide">
      <header class="section-head">
        <h2 class="section-head__title" id="work-title">
          Projects shipping out of the studio.
        </h2>
        <a href="/work" class="section-head__link">
          All projects <Arrow />
        </a>
      </header>

      <div class="work-grid">
        {
          featured.map((project, i) => (
            <ProjectCard project={project} delay={i * 0.06} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="slab" aria-labelledby="studio-title">
    <div class="container slab__inner">
      <div class="slab__copy">
      <h2 class="visually-hidden" id="studio-title">The studio</h2>
      <p class="slab__body reveal">
        We are just two dudes loving Minecraft. Maurice is just the mascot and
        Itzz_Fabi makes all the stuff. We started in 2023.
      </p>
      <ul class="slab__facts list-reset reveal" role="list">
        <li><strong class="data">{releasedCount}</strong> released projects</li>
        <li><strong class="data">{disciplineCount}</strong> disciplines</li>
        <li><strong class="data">{benchVersion}</strong> current target</li>
      </ul>
      <div class="reveal">
        <Button href="/about" variant="ghost">More about FMI</Button>
      </div>
      </div>
      <BrandSymbol class="slab__symbol" tone="color" decorative />
    </div>
  </section>

  <section class="section cta">
    <div class="container">
      <div class="cta__block block reveal">
        <h2 class="cta__title">Have an idea worth building?</h2>
        <p class="cta__text lede">
          Whether it is a modpack collaboration, a commission, or a question
          about a release, the studio is open.
        </p>
        <Button href="/contact">Get in touch</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero: an Ink slab on the symbol's own lattice */
  .hero {
    position: relative;
    z-index: var(--z-base);
    border-bottom: 1px solid var(--line);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 6.5fr) minmax(0, 5.5fr);
    align-items: center;
    gap: var(--space-l);
    padding-block: clamp(1rem, 3vh, 2.5rem) var(--space-m);
  }

  .hero__title {
    font-size: min(var(--step-5), 5rem);
    line-height: 0.98;
    max-width: 14ch;
  }

  .hero__lede {
    margin-top: var(--space-m);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
    margin-top: var(--space-m);
  }

  .hero__mark {
    display: grid;
    place-items: center;
  }

  /* Monumental: the symbol is the hero, not a badge beside it. */
  .hero__mark :global(.hero__symbol) {
    width: min(100%, 34rem);
  }

  /* On the bench: the live downloads, still inside the first viewport */
  .bench {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 2fr);
    align-items: center;
    gap: var(--space-m) var(--space-l);
    padding-block: var(--space-s) var(--space-l);
  }

  .bench__title {
    font-size: var(--step-1);
    color: var(--text);
  }

  .bench__sub {
    margin-top: var(--space-3xs);
    color: var(--text-muted);
  }

  .bench__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-m);
  }

  .bench__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);
    padding: var(--space-s);
  }

  .bench__art {
    flex-shrink: 0;
    width: 4.5rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    background: var(--well);
  }

  .bench__art img {
    width: 82%;
  }

  .bench__body {
    min-width: 0;
  }

  .bench__name {
    font-size: var(--step-0);
    line-height: 1.15;
  }

  .bench__name a:hover {
    color: var(--brass-lit);
  }

  /* The full version list, wrapped: players read it before downloading. */
  .bench__body .data {
    overflow-wrap: anywhere;
  }

  .bench__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-s);
    margin-top: var(--space-xs);
  }

  /* Section heading */
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-l);
    margin-bottom: var(--space-xl);
  }

  .section-head__title {
    font-size: var(--step-4);
    max-width: 16ch;
  }

  .section-head__link {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .section-head__link:hover {
    color: var(--brass-lit);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--space-l) var(--space-m);
  }

  /* The one lit slab: Paper, Ink lettering */
  .slab {
    position: relative;
    z-index: var(--z-base);
    background: var(--paper);
    color: var(--paper-text);
    padding-block: var(--space-2xl);
  }

  .slab__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-xl);
  }

  .slab__inner :global(.slab__symbol) {
    width: clamp(10rem, 20vw, 17rem);
  }

  .slab__body {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-3);
    line-height: 1.15;
    max-width: 26ch;
    text-wrap: balance;
  }

  .slab__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-l);
    margin-block: var(--space-l);
    color: var(--paper-muted);
  }

  .slab__facts strong {
    font-size: var(--step-0);
    color: var(--paper-text);
    font-weight: 500;
  }

  .slab :global(.btn--ghost) {
    border-color: var(--paper-text);
    color: var(--paper-text);
  }

  .slab :global(.btn--ghost:hover) {
    border-color: var(--brass-ink);
    color: var(--brass-ink);
  }

  .slab :global(:focus-visible) {
    outline-color: var(--paper-text);
  }

  /* Closing call: one big block */
  .cta {
    padding-top: var(--space-2xl);
  }

  .cta__block {
    --depth: 34px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-m);
    padding: clamp(2rem, 5vw, 4rem);
  }

  .cta__title {
    font-size: var(--step-4);
    max-width: 18ch;
  }

  @media (max-width: 960px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero__mark {
      order: -1;
      justify-items: start;
    }
    .hero__mark :global(.hero__symbol) {
      width: clamp(7rem, 28vw, 11rem);
    }
    /* minmax(0, ...) lets the long version line truncate instead of
       widening the column past the viewport. */
    .bench {
      grid-template-columns: minmax(0, 1fr);
    }
    .slab__inner {
      grid-template-columns: 1fr;
    }
    .slab__inner :global(.slab__symbol) {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .bench__list {
      grid-template-columns: minmax(0, 1fr);
    }
    .section-head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-s);
    }
  }
</style>
