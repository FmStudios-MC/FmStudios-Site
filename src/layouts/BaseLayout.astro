---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SeasonLayer from "../components/season/SeasonLayer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "FabiMvurice Interactive",
  description = "FabiMvurice Interactive is a studio crafting Minecraft modpacks, mods, resource packs, Roblox games, and standalone programs.",
} = Astro.props;

const fullTitle =
  title === "FabiMvurice Interactive"
    ? title
    : `${title} - FabiMvurice Interactive`;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1712" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />

    <!-- Preload the fonts used above the fold; rest load via @font-face -->
    <link
      rel="preload"
      href="/fonts/clash-display-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/general-sans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script is:inline>
      // Flip the no-js failsafe before paint so reveals can run.
      document.documentElement.classList.remove("no-js");

      // Seasonal theme. Halloween runs through October on the visitor's own
      // clock and switches itself off on November 1st. ?season=halloween
      // previews it any time. Keep the opt-out key in sync with season.ts.
      (function () {
        var root = document.documentElement;
        var now = new Date();
        var preview = new URLSearchParams(location.search).get("season");
        if (now.getMonth() !== 9 && preview !== "halloween") return;
        root.dataset.seasonEligible = "halloween";
        var optedOut = false;
        try {
          optedOut =
            localStorage.getItem("fmi-season-off") ===
            "halloween-" + now.getFullYear();
        } catch (e) {}
        if (optedOut && preview !== "halloween") return;
        root.dataset.season = "halloween";
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", "#16101d");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SeasonLayer />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import { initMotion } from "../scripts/motion.ts";
      import { initSeasonToggle } from "../scripts/season.ts";
      initMotion();
      initSeasonToggle();
    </script>
  </body>
</html>
