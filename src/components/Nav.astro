---
import Lockup from "../assets/brand/neolqua-horizontal-colour.svg";

const links = [
  { href: "/work", label: "Work" },
  { href: "/news", label: "News" },
  { href: "/roadmap", label: "Roadmap" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(href + "/");
---

<header class="nav" data-nav>
  <div class="nav__inner container-wide">
    <a class="nav__brand" href="/" aria-label="Neolqua Studios home">
      <Lockup class="nav__lockup" aria-hidden="true" />
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={["nav__link", { "is-active": isActive(link.href) }]}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <button
      class="nav__toggle"
      aria-expanded="false"
      aria-controls="nav-mobile"
      data-nav-toggle
    >
      <span class="visually-hidden">Toggle menu</span>
      <span class="nav__toggle-bar"></span>
      <span class="nav__toggle-bar"></span>
    </button>
  </div>

  <div class="nav__mobile" id="nav-mobile" data-nav-mobile hidden>
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={["nav__mobile-link", { "is-active": isActive(link.href) }]}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </div>
</header>

<style>
  /* The deck: the nav stands on tile and turns to a white coping strip once
     the page scrolls under it. */
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur-mid) var(--ease-out),
      border-color var(--dur-mid) var(--ease-out);
  }

  .nav[data-scrolled] {
    background: var(--coping);
    border-bottom-color: var(--edge);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: var(--space-2xs);
  }

  /* Clear space: a quarter of the drop's height on every side. */
  .nav__brand {
    display: inline-flex;
    padding-block: 0.6rem;
  }

  .nav__brand :global(.nav__lockup) {
    /* Kit minimum for the horizontal lockup is 120px wide. */
    width: clamp(150px, 13vw, 184px);
    height: auto;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.25rem);
  }

  .nav__link {
    position: relative;
    padding-block: 0.7rem;
    font-weight: 500;
    font-size: var(--step-0);
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  /* A short painted lane line under the page you are on. */
  .nav__link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0.2rem;
    height: 4px;
    width: 100%;
    border-radius: 2px;
    background: var(--lagoon);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-mid) var(--ease-out);
  }

  .nav__link:hover,
  .nav__link.is-active {
    color: var(--text);
  }

  .nav__link:hover::after,
  .nav__link.is-active::after {
    transform: scaleX(1);
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 44px;
    min-height: 44px;
    margin-right: calc(var(--space-2xs) * -1);
  }

  .nav__toggle-bar {
    width: 24px;
    height: 3px;
    border-radius: 2px;
    background: var(--abyss);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .nav__toggle[aria-expanded="true"] .nav__toggle-bar:first-child {
    transform: translateY(4.5px) rotate(45deg);
  }

  .nav__toggle[aria-expanded="true"] .nav__toggle-bar:last-child {
    transform: translateY(-4.5px) rotate(-45deg);
  }

  .nav__mobile {
    display: none;
    flex-direction: column;
    padding: var(--space-2xs) var(--space-m) var(--space-l);
    background: var(--coping);
    border-bottom: 1px solid var(--edge);
  }

  .nav__mobile[data-open] {
    display: flex;
  }

  .nav__mobile-link {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--step-2);
    font-weight: 600;
    padding-block: var(--space-xs);
    border-bottom: 1px solid var(--line);
    color: var(--text-muted);
  }

  .nav__mobile-link.is-active {
    color: var(--text);
  }

  .nav__mobile-link.is-active::before {
    content: "";
    width: 0.5em;
    height: 0.5em;
    border-radius: 999px 0 999px 999px;
    background: var(--lagoon);
  }

  @media (max-width: 760px) {
    .nav__links {
      display: none;
    }
    .nav__toggle {
      display: flex;
    }
  }
</style>
