---
interface Props {
  title: string;
  lede?: string;
}

const { title, lede } = Astro.props;
---

<header class="page-header lattice">
  <div class="container">
    <h1 class="page-header__title">{title}</h1>
    {lede && <p class="page-header__lede lede">{lede}</p>}
  </div>
</header>

<style>
  .page-header {
    position: relative;
    z-index: var(--z-base);
    padding-block: clamp(3rem, 9vh, 6rem) var(--space-xl);
    margin-bottom: var(--space-xl);
    border-bottom: 1px solid var(--line);
  }

  .page-header__title {
    font-size: var(--step-5);
    max-width: 18ch;
  }

  .page-header__lede {
    margin-top: var(--space-m);
  }
</style>
