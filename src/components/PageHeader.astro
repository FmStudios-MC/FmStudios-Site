---
interface Props {
  title: string;
  lede?: string;
}

const { title, lede } = Astro.props;
---

<header class="page-header container">
  <div class="page-header__pool water">
    <h1 class="page-header__title">{title}</h1>
    {lede && <p class="page-header__lede">{lede}</p>}
  </div>
</header>

<style>
  /* Every page opens on its own stretch of water. */
  .page-header {
    position: relative;
    z-index: var(--z-base);
    padding-block: var(--space-s) var(--space-xl);
  }

  .page-header__pool {
    border-radius: var(--drop);
    padding: clamp(2.5rem, 7vw, 5.5rem) clamp(1.5rem, 5vw, 4.5rem);
  }

  .page-header__title {
    font-size: var(--step-5);
    max-width: 16ch;
  }

  .page-header__lede {
    margin-top: var(--space-m);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 56ch;
  }
</style>
