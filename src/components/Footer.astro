---
import Stacked from "../assets/brand/fm-stacked-reversed.svg";

const year = new Date().getFullYear();

const explore = [
  { href: "/work", label: "Work" },
  { href: "/news", label: "News" },
  { href: "/roadmap", label: "Roadmap" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const elsewhere = [
  { href: "https://www.curseforge.com/members/fabimvurice_interactive/projects", label: "CurseForge" },
  { href: "https://modrinth.com/user/Itzz_Fabi", label: "Modrinth" },
  { href: "https://www.roblox.com/users/373830429/profile", label: "Roblox" },
  { href: "https://discord.gg/x9jsed8qyR", label: "Discord" },
];
---

<footer class="footer">
  <div class="footer__inner container-wide">
    <div class="footer__brand">
      <a href="/" class="footer__mark" aria-label="FabiMvurice Interactive home">
        <Stacked class="footer__lockup" aria-hidden="true" />
      </a>
      <p class="footer__line">
        FabiMvurice Interactive. Two dudes loving Minecraft.
      </p>
    </div>

    <nav class="footer__col" aria-labelledby="footer-explore">
      <h2 class="footer__heading" id="footer-explore">Explore</h2>
      {explore.map((l) => <a href={l.href} class="footer__link">{l.label}</a>)}
    </nav>

    <nav class="footer__col" aria-labelledby="footer-elsewhere">
      <h2 class="footer__heading" id="footer-elsewhere">Elsewhere</h2>
      {
        elsewhere.map((l) => (
          <a
            href={l.href}
            class="footer__link"
            target="_blank"
            rel="noopener noreferrer"
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="footer__base container-wide">
    <span>&copy; {year} Itzz_Fabi</span>
    <span>Built with deliberate craft</span>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: var(--z-base);
    background: var(--well);
    border-top: 1px solid var(--line);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: var(--space-xl);
    padding-block: var(--space-xl);
  }

  /* Stacked lockup minimum is 110px wide. */
  .footer__mark :global(.footer__lockup) {
    width: 132px;
    height: auto;
  }

  .footer__mark {
    display: inline-flex;
  }

  .footer__line {
    margin-top: var(--space-s);
    color: var(--text-muted);
    font-size: var(--step--1);
    max-width: 38ch;
  }

  .footer__heading {
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    color: var(--text);
    margin-bottom: var(--space-s);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .footer__link {
    color: var(--text-muted);
    width: fit-content;
    padding-block: 0.15rem;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .footer__link:hover {
    color: var(--text);
  }

  .footer__base {
    display: flex;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: var(--space-m);
    border-top: 1px solid var(--line);
    color: var(--text-faint);
    font-size: var(--step--1);
  }

  @media (max-width: 720px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
    .footer__base {
      flex-direction: column;
      gap: var(--space-2xs);
    }
  }
</style>
