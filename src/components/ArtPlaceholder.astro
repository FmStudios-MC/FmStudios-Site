---
/* Stands in for project art that does not exist yet, marked as such so it
   never passes for the real thing: the name on an empty patch of water. */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="art-placeholder">
  <span class="art-placeholder__name" aria-hidden="true">{title}</span>
  <span class="art-placeholder__note">Art coming soon</span>
</div>

<style>
  .art-placeholder {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    width: 100%;
    height: 100%;
    padding: var(--space-m);
    border: 2px dashed var(--abyss);
    border-radius: var(--drop-s);
    text-align: center;
    color: var(--abyss);
  }

  .art-placeholder__name {
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1;
    /* Break only between words, so "{Additions}" keeps its braces. */
    overflow-wrap: break-word;
  }

  .art-placeholder__note {
    font-size: var(--step--1);
    font-weight: 500;
  }
</style>
