---
/* Stands in for project art that does not exist yet, marked as such so it
   never passes for the real thing: the name on a blank face. */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="art-placeholder">
  <span class="art-placeholder__name" aria-hidden="true">{title}</span>
  <span class="art-placeholder__note">Art coming soon</span>
</div>

<style>
  .art-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    width: 100%;
    height: 100%;
    padding: var(--space-m);
    border: 1px dashed var(--line-strong);
    text-align: center;
  }

  .art-placeholder__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1;
    text-transform: uppercase;
    color: var(--line-strong);
    /* Break only between words, so "{Additions}" keeps its braces. */
    overflow-wrap: break-word;
  }

  .art-placeholder__note {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
</style>
