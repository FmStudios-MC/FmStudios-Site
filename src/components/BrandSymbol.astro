---
/* The logo kit's symbol (reversed or colour version), inlined so its
   three faces can assemble on load. The paths are the kit's master artwork,
   unchanged: never redraw or recolour them. */
interface Props {
  size?: number | string;
  class?: string;
  /** Assemble the faces on first paint (hero use only). */
  assemble?: boolean;
  /** Decorative uses hide it from assistive tech. */
  decorative?: boolean;
  /** "reversed" for Ink grounds, "color" for Paper and light grounds. */
  tone?: "reversed" | "color";
}

const {
  size = 256,
  class: className = "",
  assemble = false,
  decorative = false,
  tone = "reversed",
} = Astro.props;

const faces = tone === "color" ? "#1D2030" : "#FFFFFF";
---

<svg
  class:list={["symbol", { "symbol--assemble": assemble }, className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  width={size}
  height={size}
  role={decorative ? undefined : "img"}
  aria-hidden={decorative ? "true" : undefined}
  aria-label={decorative ? undefined : "FabiMvurice Interactive"}
>
  <path
    class="symbol__top"
    fill="#C98516"
    transform="matrix(1.0392 -0.6 1.0392 0.6 24.08 68)"
    d="M3 0H100V97H3z"></path>
  <path
    class="symbol__left"
    fill={faces}
    fill-rule="evenodd"
    transform="matrix(1.0392 0.6 0 1.2 24.08 68)"
    d="M0 3H97V100H0zM26 20h50v16H42v11h26v14H42v24H26z"></path>
  <path
    class="symbol__right"
    fill={faces}
    fill-rule="evenodd"
    transform="matrix(1.0392 -0.6 0 1.2 128 128)"
    d="M3 3H100V100H3zM18 20h16l16 30 16-30h16v65H68V44L54 70h-8L32 44v41H18z"
  ></path>
</svg>

<style>
  .symbol {
    width: var(--symbol-size, auto);
    height: auto;
    overflow: visible;
  }

  /* One authored moment: the block assembles along its own axes. The top
     face settles from above, the carved faces slide in from their sides. */
  @media (prefers-reduced-motion: no-preference) {
    .symbol--assemble path {
      animation: face-in 0.9s var(--ease-out) both;
    }

    .symbol--assemble .symbol__top {
      --from: 0 -18px;
      animation-delay: 0.32s;
    }

    .symbol--assemble .symbol__left {
      --from: -16px 9px;
      animation-delay: 0.08s;
    }

    .symbol--assemble .symbol__right {
      --from: 16px 9px;
      animation-delay: 0.18s;
    }
  }

  @keyframes face-in {
    from {
      opacity: 0;
      translate: var(--from);
    }
  }
</style>
