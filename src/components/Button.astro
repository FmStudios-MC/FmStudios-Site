---
import Arrow from "./Arrow.astro";

interface Props {
  href: string;
  variant?: "primary" | "ghost";
  size?: "default" | "small";
  class?: string;
  external?: boolean;
}

const {
  href,
  variant = "primary",
  size = "default",
  class: className = "",
  external = false,
} = Astro.props;

const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

<a
  href={href}
  class:list={[
    "btn",
    `btn--${variant}`,
    { "btn--small": size === "small" },
    { "block block--live": variant === "primary" },
    className,
  ]}
  rel={rel}
  target={target}
>
  <span class="btn__label"><slot /></span>
  <span class="btn__arrow"><Arrow /></span>
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    min-height: 48px;
    padding: 0.8em 1.3em 0.75em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .btn--small {
    min-height: 40px;
    padding: 0.6em 0.95em 0.55em;
    font-size: 0.78rem;
  }

  .btn--small.btn--primary {
    --depth: 6px;
  }

  .btn__arrow {
    display: inline-flex;
    font-size: 1.15em;
    transition: transform var(--dur-mid) var(--ease-out);
  }

  .btn:hover .btn__arrow {
    transform: translateX(0.2em);
  }

  /* Primary is a small brass block: lit top, deep side, and it presses in. */
  .btn--primary {
    --depth: 8px;
    --side: var(--brass-deep);
    --top: #edc06e;
    background: var(--brass);
    color: var(--on-brass);
  }

  .btn--primary:hover,
  .btn--primary:focus-visible {
    --lift: 4px;
    --top: #f6d596;
  }

  .btn--primary:active {
    --lift: -8px;
  }

  .btn--ghost {
    border: 1px solid var(--line-strong);
    color: var(--text);
  }

  .btn--ghost:hover {
    border-color: var(--brass);
    color: var(--brass-lit);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:hover .btn__arrow {
      transform: none;
    }
  }
</style>
