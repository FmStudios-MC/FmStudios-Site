---
import Arrow from "./Arrow.astro";

interface Props {
  href: string;
  variant?: "primary" | "ghost";
  size?: "default" | "small";
  class?: string;
  external?: boolean;
}

const {
  href,
  variant = "primary",
  size = "default",
  class: className = "",
  external = false,
} = Astro.props;

const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

<a
  href={href}
  class:list={["btn", `btn--${variant}`, { "btn--small": size === "small" }, className]}
  rel={rel}
  target={target}
>
  <span class="btn__label"><slot /></span>
  <span class="btn__arrow"><Arrow /></span>
</a>

<style>
  /* A pool sign you press: the drop's silhouette, three round corners and
     the top-right one square. Painted Abyss works on tile and on water. */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    min-height: 48px;
    padding: 0.75em 1.35em 0.75em 1.5em;
    border-radius: var(--drop-pill);
    font-weight: 600;
    font-size: var(--step-0);
    line-height: 1;
    white-space: nowrap;
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      scale var(--dur-fast) var(--ease-out);
  }

  .btn--small {
    min-height: 44px;
    padding: 0.6em 1em 0.6em 1.15em;
    font-size: var(--step--1);
  }

  .btn__arrow {
    display: inline-flex;
    font-size: 1.1em;
    transition: transform var(--dur-mid) var(--ease-out);
  }

  .btn:hover .btn__arrow {
    transform: translateX(0.22em);
  }

  .btn:active {
    scale: 0.97;
  }

  .btn--primary {
    background: var(--abyss);
    color: var(--coping);
  }

  .btn--primary:hover {
    color: var(--neo-aqua);
  }

  .btn--ghost {
    border: 1.5px solid var(--abyss);
    color: var(--abyss);
  }

  .btn--ghost:hover {
    background: var(--abyss);
    color: var(--coping);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:hover .btn__arrow {
      transform: none;
    }
    .btn:active {
      scale: none;
    }
  }
</style>
