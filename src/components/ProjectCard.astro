---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Arrow from "./Arrow.astro";
import ArtPlaceholder from "./ArtPlaceholder.astro";

interface Props {
  project: CollectionEntry<"projects">;
  delay?: number;
  /** Set on cards that land at or above the fold, so the art is not deferred. */
  priority?: boolean;
}

const { project, delay = 0, priority = false } = Astro.props;
const { data } = project;
const isLive = data.status === "Released";
---

<a
  href={`/work/${project.id}`}
  class="pblock block block--live reveal"
  style={`--reveal-delay:${delay}s`}
>
  <div class="pblock__art lattice">
    {
      data.image ? (
        <Image
          src={data.image}
          alt=""
          width={480}
          height={480}
          class="pblock__img"
          loading={priority ? "eager" : "lazy"}
          fetchpriority={priority ? "high" : "auto"}
        />
      ) : (
        <ArtPlaceholder title={data.title} />
      )
    }
  </div>

  <div class="pblock__body">
    <h3 class="pblock__title">{data.title}</h3>
    <p class="pblock__tagline">{data.tagline}</p>
    <div class="pblock__meta">
      <span class:list={["plate", { "plate--lit": isLive }]}>{data.status}</span>
      <span class="data">{[data.type, data.loader].filter(Boolean).join(" / ")}</span>
    </div>
    {data.version && <p class="data pblock__version">MC {data.version}</p>}
    <div class="pblock__foot">
      <span class="pblock__cta">
        View project <span class="pblock__cta-icon"><Arrow /></span>
      </span>
    </div>
  </div>
</a>

<style>
  .pblock {
    display: flex;
    flex-direction: column;
    height: calc(100% - var(--depth) * 0.5);
  }

  .pblock__art {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 11;
    padding: var(--space-m);
    background-color: var(--well);
    overflow: hidden;
  }

  .pblock__img {
    width: min(70%, 260px);
    height: auto;
    object-fit: contain;
    transition: scale var(--dur-slow) var(--ease-out);
  }

  .pblock:hover .pblock__img {
    scale: 1.05;
  }

  .pblock__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-m);
  }

  .pblock__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-2xs);
  }

  .pblock__title {
    font-size: var(--step-2);
    line-height: 1.05;
  }

  .pblock__tagline {
    color: var(--text-muted);
    line-height: 1.5;
  }

  .pblock__foot {
    margin-top: auto;
    padding-top: var(--space-s);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
  }

  /* The full version list: it is what players check before downloading. */
  .pblock__version {
    overflow-wrap: anywhere;
  }

  .pblock__cta {
    flex-shrink: 0;
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
  }

  .pblock__cta-icon {
    display: inline-flex;
    transition: transform var(--dur-mid) var(--ease-out);
  }

  .pblock:hover .pblock__cta-icon {
    transform: translateX(0.25em);
  }

  .pblock:hover .pblock__cta {
    color: var(--brass-lit);
  }

  @media (prefers-reduced-motion: reduce) {
    .pblock:hover .pblock__img {
      scale: none;
    }
    .pblock:hover .pblock__cta-icon {
      transform: none;
    }
  }
</style>
