---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Arrow from "./Arrow.astro";
import ArtPlaceholder from "./ArtPlaceholder.astro";
import Depth from "./Depth.astro";

interface Props {
  project: CollectionEntry<"projects">;
  delay?: number;
  /** Set on cards that land at or above the fold, so the art is not deferred. */
  priority?: boolean;
}

const { project, delay = 0, priority = false } = Astro.props;
const { data } = project;
const isLive = data.status === "Released";
---

<a
  href={`/work/${project.id}`}
  class="pcard reveal"
  style={`--reveal-delay:${delay}s`}
>
  <div class="pcard__art">
    <div class="pcard__pool water" aria-hidden="true"></div>
    {
      data.image ? (
        <Image
          src={data.image}
          alt=""
          width={480}
          height={480}
          class="pcard__img"
          loading={priority ? "eager" : "lazy"}
          fetchpriority={priority ? "high" : "auto"}
        />
      ) : (
        <ArtPlaceholder title={data.title} />
      )
    }
  </div>

  <div class="pcard__body">
    <h3 class="pcard__title">{data.title}</h3>
    <p class="pcard__tagline">{data.tagline}</p>
    <div class="pcard__meta">
      <span class:list={["plate", { "plate--lit": isLive }]}>{data.status}</span>
      <span class="pcard__kind">{[data.type, data.loader].filter(Boolean).join(" · ")}</span>
    </div>
    {data.version && <Depth version={data.version} class="pcard__depth" />}
    <span class="pcard__cta">
      View project <span class="pcard__cta-icon"><Arrow /></span>
    </span>
  </div>
</a>

<style>
  /* A coping slab with its own little pool. */
  .pcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--coping);
    border: 1px solid var(--edge);
    border-bottom-width: 4px;
    border-radius: var(--drop);
    overflow: hidden;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .pcard:hover,
  .pcard:focus-visible {
    border-color: var(--lagoon);
  }

  /* The art well: tiled wall above, water below. The water line rises when
     the card is pointed at, and the art floats up with it. */
  .pcard__art {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 11;
    padding: var(--space-m);
    background-color: var(--tile);
    background-image:
      linear-gradient(var(--grout) 1px, transparent 1px),
      linear-gradient(90deg, var(--grout) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: -1px -1px;
    overflow: hidden;
    border-radius: calc(var(--r) - 1px) 0 0 0;
  }

  .pcard__pool {
    position: absolute;
    inset: auto 0 0 0;
    height: 62%;
    background-size: 24px 24px;
    transition: height var(--dur-slow) var(--ease-water);
  }

  .pcard:hover .pcard__pool,
  .pcard:focus-visible .pcard__pool {
    height: 100%;
  }

  .pcard__img {
    position: relative;
    width: min(64%, 240px);
    height: auto;
    object-fit: contain;
    transition: translate var(--dur-slow) var(--ease-water);
  }

  .pcard:hover .pcard__img,
  .pcard:focus-visible .pcard__img {
    translate: 0 -6%;
  }

  .pcard__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-m);
  }

  .pcard__title {
    font-size: var(--step-2);
    line-height: 1.08;
  }

  .pcard__tagline {
    color: var(--text-muted);
    line-height: 1.5;
  }

  .pcard__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-2xs);
  }

  .pcard__kind {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text-faint);
  }

  /* Every tile in a row shares one footprint; the version marking and the
     link sit on its foot so the spare water stays above them. */
  .pcard :global(.pcard__depth) {
    margin-top: auto;
    padding-top: var(--space-xs);
    border-top: 1px solid var(--line);
    color: var(--text-faint);
  }

  .pcard__cta {
    margin-top: auto;
    padding-top: var(--space-s);
    align-self: flex-end;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--text);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .pcard :global(.pcard__depth) + .pcard__cta {
    margin-top: 0;
  }

  .pcard__cta-icon {
    display: inline-flex;
    transition: transform var(--dur-mid) var(--ease-out);
  }

  .pcard:hover .pcard__cta {
    color: var(--link);
  }

  .pcard:hover .pcard__cta-icon {
    transform: translateX(0.25em);
  }

  @media (prefers-reduced-motion: reduce) {
    .pcard__pool,
    .pcard__img,
    .pcard__cta-icon {
      transition: none;
    }
  }
</style>
